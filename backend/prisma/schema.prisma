generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADM
  PBR
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(PBR)
  posts     Post[]
  createdAt DateTime @default(now())
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  slug        String   @unique
  thumbnail   String?
  content     String   @db.LongText
  scheduledAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("offAir")
  slide Boolean @default(false)

  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int

  author   User @relation(fields: [authorId], references: [id])
  authorId Int
}
